# Copy to .env and adjust — never commit real secrets.
SECRET_KEY=change-me-in-production
DATABASE_PATH=tariff_advisor.sqlite3
# Workbook path (defaults to dataset/...xlsx inside this folder)
# WORKBOOK_PATH=/absolute/path/to/workbook.xlsx
RESULTS_DIR=results
TZ_NAME=Asia/Baku

# Recommendation knobs
HISTORY_WINDOW_MONTHS=3
DEMAND_BUFFER_RATIO=0.5
EXTRA_PACK_SIZE_GB=1.0

# Demo credentials (demo mode only — hashed at rest)
DEMO_CUSTOMER_EMAIL=customer@demo.local
DEMO_CUSTOMER_PASSWORD=Demo-Customer-2026
DEMO_CUSTOMER2_EMAIL=customer2@demo.local
DEMO_CUSTOMER2_PASSWORD=Demo-Customer2-2026
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Demo-Admin-2026
DEMO_MODE=1
